# upstream installs the 8.4 helpers in $(LIBDIR) but still looks them up in /lib/drbd,
# which only works on usr-merged systems
diff -urN drbd-utils-9.35.0.orig/user/v84/drbdadm_usage_cnt.c drbd-utils-9.35.0/user/v84/drbdadm_usage_cnt.c
--- drbd-utils-9.35.0.orig/user/v84/drbdadm_usage_cnt.c	2026-09-30 10:55:38.000000000 +0200
+++ drbd-utils-9.35.0/user/v84/drbdadm_usage_cnt.c	2026-10-29 00:50:47.950031881 +0100
@@ -285,7 +285,7 @@
 	m_asprintf(&new_path, "%s%s%s",
 			old_path,
 			old_path ? ":" : "",
-			"/lib/drbd");
+			DRBD_LIBEXEC_DIR);
 	setenv("PATH", new_path, 1);
 }
 
diff -urN drbd-utils-9.35.0.orig/user/v84/Makefile.in drbd-utils-9.35.0/user/v84/Makefile.in
--- drbd-utils-9.35.0.orig/user/v84/Makefile.in	2026-09-30 10:55:38.000000000 +0200
+++ drbd-utils-9.35.0/user/v84/Makefile.in	2026-10-29 00:50:47.949612250 +0100
@@ -45,6 +45,7 @@
 DESTDIR ?= /
 
 CFLAGS += -Wall -I. -I../shared
+CFLAGS += -DDRBD_LIBEXEC_DIR='"$(LIBDIR)"'
 CFLAGS += $(EXTRA_CFLAGS)
 
 drbdadm-obj = drbdadm_scanner.o drbdadm_parser.o drbdadm_main.o \
